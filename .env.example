# Copy to `.env` and adjust. Do not commit real secrets.
#
# Compose loads this file for variable substitution and for `env_file` on several services.
# Keep PostgreSQL credentials centralized in POSTGRESQL_*.

# --- PostgreSQL (Bitnami `db` service) ---
POSTGRESQL_HOST=db
POSTGRESQL_USERNAME=postgres
POSTGRESQL_PASSWORD=changeme
POSTGRESQL_DATABASE=vuln_commander
POSTGRESQL_PORT_NUMBER=5432

# --- Landing page external links (optional overrides) ---
# GRAFANA_URL=http://localhost:3000
# GRAYLOG_URL=http://localhost:9000
# PGADMIN_URL=http://localhost:8080

# --- pgAdmin (`db-ui`) ---
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=changeme

# --- Grafana ---
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=changeme

# --- Graylog 6.x (server + datanode read from the same file) ---
# At least 16 characters; used for encryption.
GRAYLOG_PASSWORD_SECRET=please-change-at-least-16-chars
# DataNode 6.x often expects its own secret (can match GRAYLOG_PASSWORD_SECRET).
GRAYLOG_DATANODE_PASSWORD_SECRET=please-change-at-least-16-chars
# SHA-256 hex of the Graylog root password, e.g. `echo -n 'yourpassword' | shasum -a 256`
GRAYLOG_ROOT_PASSWORD_SHA2=8c6976e5b5410415bde908bd4dee15dfb167a9c873fc4bb8a81f6f2ab448a918

# Optional image overrides (see docker-compose.yml)
# GRAYLOG_IMAGE=graylog/graylog:6.3
# DATANODE_IMAGE=graylog/graylog-datanode:6.3

# --- Optional: one-shot bootstrap after migrations (API entrypoint) ---
# Admin is created only when there are zero users and both email and password are set.
ADMIN_EMAIL=changeme
ADMIN_PASSWORD=changeme
ADMIN_FIRST_NAME=changeme
ADMIN_LAST_NAME=changeme
ADMIN_TEAM=changeme

# Connectors: set PASSWORD and UUID to create the row if missing (idempotent by connector `name`).
# UUID must match CONNECTOR_ID in that connector’s `.env` (same id the connector sends to the API).
CONNECTOR_GITHUB_UUID=89d4ec68-d74d-44de-b77f-45e2791b618a
CONNECTOR_GITHUB_PASSWORD=changeme
CONNECTOR_GSS_UUID=82e81ef5-35a5-4fdd-ab43-e04122ad9361
CONNECTOR_GSS_PASSWORD=changeme
CONNECTOR_IAC_UUID=45c5b30e-2215-422b-803a-a9d3eff3cc31
CONNECTOR_IAC_PASSWORD=changeme
CONNECTOR_SCA_LICENSE_UUID=1e68f27f-41af-4483-9c0e-23786784973b
CONNECTOR_SCA_LICENSE_PASSWORD=changeme
CONNECTOR_SCA_VULN_UUID=c4114975-507a-4011-8407-932d1e506def
CONNECTOR_SCA_VULN_PASSWORD=changeme

# Avoiding 403 status code when making requests to the GitHub Release API
# Used to download scanner sources
GITHUB_TOKEN=changeme
